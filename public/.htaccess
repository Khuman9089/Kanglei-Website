# ─────────────────────────────────────────────────────────────
# Hostinger LiteSpeed / Apache Reverse Proxy Configuration for Next.js
# ─────────────────────────────────────────────────────────────

<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Preserve HTTPS protocol header
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Prioritize Next.js App Router dynamic routes
  RewriteRule ^blog(/.*)?$ http://127.0.0.1:3000/blog$1 [P,L]
  RewriteRule ^api(/.*)?$ http://127.0.0.1:3000/api$1 [P,L]

  # 2b. Serve public assets directly from public/assets if present
  RewriteCond %{DOCUMENT_ROOT}/public/assets/$1 -f
  RewriteRule ^assets/(.*)$ public/assets/$1 [L]

  # 3. Serve physical static files directly if existing
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 4. Proxy all dynamic routes to Node.js PM2 / Next.js server on port 3000
  RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
</IfModule>

# Fix 403 Forbidden directory index error
DirectoryIndex index.html index.php disabled
Options -Indexes +FollowSymLinks
